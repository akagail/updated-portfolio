DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ORIGINS=http://localhost:3000
# Either DATABASE_URL (Render/Supabase) or discrete POSTGRES_* vars below.
DATABASE_URL=
POSTGRES_DB=aidb
POSTGRES_USER=bob
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Media storage (Supabase Storage S3). Leave blank to keep uploads on local disk.
# Endpoint + region are shown on the Supabase Storage > S3 configuration page.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=media
# Optional: override the public URL base (derived from the endpoint by default).
AWS_S3_CUSTOM_DOMAIN=
